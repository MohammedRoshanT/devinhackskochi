{
  "name": "authorization-assurance-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "lab": "tsx src/cli/lab.ts",
    "db:start": "tsx src/cli/db.ts start",
    "db:init": "tsx src/cli/db.ts init",
    "db:stop": "tsx src/cli/db.ts stop",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "validate": "tsx src/cli/validate.ts",
    "hooks:install": "sh scripts/install-hooks.sh",
    "lab:compare": "tsx src/cli/compare.ts"
  },
  "dependencies": {
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
